{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "drfxquant-mini",
  "main": "dist/worker.mjs",
  "compatibility_date": "2026-10-24",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGIN": ""
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "SIGNALS_DB",
      "database_name": "drfxquant-mini",
      "database_id": "3fdb52b2-a998-4cd5-ae1b-3307d7918c4e",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
