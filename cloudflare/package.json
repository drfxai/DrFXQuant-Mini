{
  "name": "drfxquant-mini-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test test/*.test.mjs",
    "migrate:local": "wrangler d1 migrations apply drfxquant-mini --local",
    "migrate:remote": "wrangler d1 migrations apply drfxquant-mini --remote",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
